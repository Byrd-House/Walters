# Copy to .env and fill in. All values are server-only secrets (never exposed to
# the browser). In dev, leads are logged to the console until these are set.

# --- Email fallback (Resend) — the GUARANTEED lead capture -------------------
# Create a key at resend.com and verify a sending domain (SPF/DKIM) or mail
# lands in spam. LEAD_FALLBACK_EMAIL is where new leads are delivered.
RESEND_API_KEY=
LEAD_FALLBACK_EMAIL=
LEAD_FROM_EMAIL="Walter's Website <leads@your-domain.com>"

# --- Jobber GraphQL API (best-effort CRM sync) ------------------------------
# Register an app in Jobber's Developer Center, then obtain a refresh token via
# the OAuth flow (see README). Leave blank to skip Jobber entirely.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REFRESH_TOKEN=
# [VERIFY-LIVE] current API version date from the Jobber changelog before launch.
JOBBER_API_VERSION=2025-04-16

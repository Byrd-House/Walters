# Copy to .env and fill in. All values are server-only secrets (never exposed to
# the browser). In dev, leads are logged to the console until these are set.

# --- Email (Resend) — the GUARANTEED lead capture ----------------------------
# NOT a fallback despite the var name below: the email sink is durable, so the
# visitor's success response depends on it. Jobber is the best-effort extra.
#
# Provisioned via the Vercel Marketplace (`vercel integration add
# resend/resend-email`), which injects RESEND_API_KEY into the project — pull it
# locally with `vercel env pull`. Sending domain is the send.* subdomain, kept
# off the apex so a future Google Workspace SPF record can't collide with it.
RESEND_API_KEY=
# Where new leads are delivered. One address, or several comma-separated.
LEAD_FALLBACK_EMAIL=jbwalters3327@gmail.com,brooks@byrdhouse.xyz
LEAD_FROM_EMAIL="Jesse Walters Website <leads@send.jessewalterslandscaping.com>"

# --- Meta Conversions API (server-side half of the Lead event) ---------------
# The pixel ID itself is NOT here: it ships in the page source and lives in
# src/data/site.ts (tracking.metaPixel), which is also what the privacy policy
# renders its disclosure from. Only the token is secret.
#
# Mint it in Events Manager > your pixel > Settings > "Generate access token"
# (or a System User token in Business Settings with the ads_management scope).
# Leave blank to skip the server-side event entirely — the browser pixel still
# fires Lead on its own, it just loses the submissions ad blockers eat.
META_CAPI_ACCESS_TOKEN=
# Optional. Set while verifying to route events to Events Manager > Test Events
# (the code is shown on that tab), then UNSET it — test events never appear in
# reporting, so leaving it set means no conversions are recorded.
META_CAPI_TEST_EVENT_CODE=
# Optional override. Graph API v26.0 shipped 2026-07-29; Meta retires a version
# roughly every two years, so bump this rather than editing code.
META_GRAPH_API_VERSION=v26.0

# --- Jobber GraphQL API (best-effort CRM sync) ------------------------------
# Syncs each website lead into Jobber as a CLIENT (Jobber's API can't create a
# "Request", and client notes aren't writable — see README). Register an app in
# Jobber's Developer Center with WRITE access to clients, set a Redirect URI, and
# turn Refresh Token Rotation OFF (long-lived token for a private/custom
# integration). Then mint the refresh token: `node scripts/jobber-auth.mjs`.
# Leave blank to skip Jobber entirely — the email sink still captures every lead.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=
JOBBER_REFRESH_TOKEN=
# Confirm the current version date in Jobber's GraphiQL / changelog before launch.
JOBBER_API_VERSION=2025-04-16
# Optional: request details on the Jobber client. Run
# `node scripts/jobber-custom-field.mjs` and paste the JSON map it prints here.
# One field per datum because Jobber has no multi-line text type — packed
# newlines collapse when rendered. The fields must be created BY THE APP: Jobber
# hides custom fields it didn't create from the API, so ones made by hand in
# Settings are unusable. Without this, the client is created without those
# details (they always still arrive in the lead email).
JOBBER_LEAD_CUSTOM_FIELD_IDS=

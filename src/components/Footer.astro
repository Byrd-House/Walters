---
import { site, nav } from "../data/site";
const year = new Date().getFullYear();
const areas = site.areas.join(", ");
// Mirror the nav wordmark: apostrophe stripped, set uppercase + letter-spaced below.
const wordmark = site.name.replace(/['']/g, "");
---

<footer class="border-t border-green-800 bg-green-900 text-green-50">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-4 lg:px-6">
    <div class="sm:col-span-2 lg:col-span-1">
      <p class="font-display text-h3 uppercase tracking-[0.1em] text-white">{wordmark}</p>
      <p class="mt-1 font-sans text-small uppercase tracking-[0.12em] text-green-200">{site.tagline}</p>
      <p class="mt-4 max-w-xs font-sans text-small text-green-100">
        Fully insured · rated {site.rating.value.toFixed(1)} ★ across {site.rating.count} reviews.
      </p>
    </div>

    <div>
      <h2 class="font-sans text-small font-bold text-white">Get in touch</h2>
      <ul class="mt-3 space-y-1 font-sans text-small text-green-100">
        <li><a href={site.phoneHref} class="inline-block py-1.5 hover:text-white">{site.phone}</a></li>
        {/* TODO[CONFIRM]: business email — omitted until confirmed (no fake data) */}
        {site.email && <li><a href={`mailto:${site.email}`} class="inline-block py-1.5 hover:text-white">{site.email}</a></li>}
        <li><a href="/contact" class="inline-block py-1.5 hover:text-white">Get a quote</a></li>
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-small font-bold text-white">Service area</h2>
      <p class="mt-3 max-w-xs font-sans text-small text-green-100">
        {areas}
      </p>
      {/* TODO[CONFIRM]: business hours — omitted until confirmed */}
      {site.hours && <p class="mt-2 font-sans text-small text-green-200">{site.hours}</p>}
    </div>

    <nav aria-label="Footer">
      <h2 class="font-sans text-small font-bold text-white">Explore</h2>
      <ul class="mt-3 space-y-1 font-sans text-small text-green-100">
        {nav.map((item) => <li><a href={item.href} class="inline-block py-1.5 hover:text-white">{item.label}</a></li>)}
      </ul>
      {/* TODO[CONFIRM]: social profile URLs (handle "JW Landscape and Maintenance") */}
      {
        (site.social.facebook || site.social.instagram) && (
          <ul class="mt-4 flex gap-4 font-sans text-small text-green-100">
            {site.social.facebook && <li><a href={site.social.facebook} class="inline-block py-1.5 hover:text-white">Facebook</a></li>}
            {site.social.instagram && <li><a href={site.social.instagram} class="inline-block py-1.5 hover:text-white">Instagram</a></li>}
          </ul>
        )
      }
    </nav>
  </div>

  <div class="border-t border-green-800">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 font-sans text-caption text-green-200 sm:flex-row sm:items-center sm:justify-between lg:px-6"
    >
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul class="flex gap-5">
        <li><a href="/privacy" class="hover:text-white">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-white">Terms of Service</a></li>
      </ul>
    </div>
  </div>
</footer>

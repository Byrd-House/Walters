---
import QuoteForm from "./QuoteForm.astro";
---

<section id="quote" class="scroll-mt-24 bg-green-800">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:px-6 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="font-heading text-[clamp(2.75rem,6vw,5rem)] font-bold leading-[1.05] text-white">Take your weekends back.</h2>
        <p class="mt-5 max-w-md font-sans text-body text-green-100">
          Fill out the form with what you have in mind. Don't have it all nailed down? We'll come by
          for a free consultation.
        </p>
      </div>
      <div class="rounded-xl bg-paper p-6 shadow-[0_12px_40px_rgba(29,48,40,0.18)] sm:p-8">
        <QuoteForm />
      </div>
    </div>
  </div>
</section>

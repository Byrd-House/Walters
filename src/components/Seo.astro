---
import { site, serviceGroups } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Extra page-level JSON-LD (e.g. Service graph on /services, FAQPage). */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.legalName,
  description = "Full-service landscaping and construction in Chapel Hill, NC. Lawn care, mulch, patios, walkways, and construction, done right.",
  image = "/og-default.jpg",
  noindex = false,
  schema,
} = Astro.props;

const extraSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const tabTitle = title;

// schema.org LocalBusiness (brief §8). `alternateName` + `sameAs` are the entity
// signals: they tell search and answer engines that this site, the Google
// Business Profile, and the social accounts are one business rather than three.
// No openingHours — the business keeps no fixed hours (site.hours is null), and
// omitting the property is correct where inventing one would not be.
const sameAs = [site.social.facebook, site.social.instagram].filter(Boolean) as string[];

// BreadcrumbList for every page below the root. Search results render these as a
// path instead of a bare URL, and answer engines use them to place a page inside
// the site rather than treating it as a loose document. Generated from the path so
// a new page gets one without remembering to ask.
const BREADCRUMB_LABELS: Record<string, string> = {
  services: "Services",
  about: "About",
  faq: "FAQ",
  "service-area": "Service Area",
  contact: "Contact",
  privacy: "Privacy Policy",
  terms: "Terms of Service",
};

const segments = Astro.url.pathname.split("/").filter(Boolean);
const breadcrumbSchema =
  segments.length && !noindex
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: Astro.site?.href },
          ...segments.map((seg, i) => ({
            "@type": "ListItem",
            position: i + 2,
            name: BREADCRUMB_LABELS[seg] ?? seg,
            item: new URL(`/${segments.slice(0, i + 1).join("/")}`, Astro.site).href,
          })),
        ],
      }
    : null;

// Everything below is stated fact from site data or Jesse's questionnaire. Do not
// add a property here that needs a guess — an invented figure in structured data
// is repeated verbatim by answer engines, with no visible page text to correct it.
const paymentAccepted = "Cash, Check, Credit Card, Venmo, Bank Transfer";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LandscapingBusiness",
  name: site.legalName,
  alternateName: site.gbpName,
  description,
  telephone: site.phone,
  ...(site.email ? { email: site.email } : {}),
  url: Astro.site?.href,
  image: ogImage,
  ...(sameAs.length ? { sameAs } : {}),
  areaServed: site.areasServed.map((a) => ({ "@type": "City", name: a })),
  address: {
    "@type": "PostalAddress",
    addressRegion: site.region,
    postalCode: site.zip,
    addressCountry: "US",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: site.rating.value,
    reviewCount: site.rating.count,
  },
  // From the FAQ answers — real terms, not boilerplate.
  paymentAccepted,
  currenciesAccepted: "USD",
  // Owner-operated is the actual differentiator against the franchises, and it
  // gives answer engines a person to resolve "who is Jesse Walters" against.
  founder: { "@type": "Person", name: site.name },
  priceRange: "$$",
  knowsAbout: serviceGroups.map((g) => g.title),
};
---

<title>{tabTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.legalName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
{extraSchema.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}

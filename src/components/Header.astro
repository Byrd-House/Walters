---
import { Image } from "astro:assets";
import logo from "../assets/logo/logo.png";
import { site, nav } from "../data/site";
import MobileNav from "./MobileNav.astro";

// Logo wordmark: drop the apostrophe and letter-space it. The canonical brand
// name (site.name) keeps its apostrophe everywhere else (SEO, alt text, JSON-LD).
const wordmark = site.name.replace(/['']/g, "");
---

<header class="relative z-50 border-b border-line bg-paper">
  <div class="relative mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 lg:px-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.legalName}, home`}>
      <Image src={logo} alt="" width={128} height={128} class="h-16 w-16 object-contain" />
      <span class="flex flex-col">
        <span class="font-display text-2xl uppercase tracking-normal leading-none text-green-900">{wordmark}</span>
        <span class="mt-1 font-sans text-[12px] font-medium uppercase tracking-[0.55em] text-green-700">
          {site.tagline}
        </span>
      </span>
    </a>

    <div class="hidden items-center gap-8 lg:flex">
      <nav class="flex items-center gap-7" aria-label="Primary">
        {
          nav.map((item) => (
            <a href={item.href} class="font-sans text-body text-green-800 transition-colors hover:text-green-900">
              {item.label}
            </a>
          ))
        }
      </nav>
      <a
        href="/contact"
        class="rounded-md bg-green-700 px-4 py-2.5 font-sans text-body font-bold text-white transition duration-200 hover:-translate-y-0.5 hover:bg-green-800 hover:shadow-lg hover:shadow-green-900/25 active:translate-y-0"
      >
        Get a Quote
      </a>
    </div>

    <MobileNav />
  </div>
</header>

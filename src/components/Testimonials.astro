---
import { getCollection } from "astro:content";
import { site } from "../data/site";

const items = (await getCollection("testimonials")).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
---

<section class="bg-green-50">
  <div class="mx-auto max-w-7xl px-4 py-20 lg:px-6 lg:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-heading text-h2 font-bold text-green-900">
        Rated {site.rating.value.toFixed(1)} stars across {site.rating.count} reviews, and counting.
      </h2>
    </div>

    {
      items.length > 0 ? (
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {items.map((t) => (
            <li class="flex flex-col rounded-lg border border-line bg-paper p-6">
              <div
                class="flex gap-0.5 text-[#FBBC04]"
                role="img"
                aria-label={`Rated ${t.data.rating} out of 5 stars`}
              >
                {Array.from({ length: t.data.rating }).map(() => (
                  <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.368 2.447a1 1 0 00-.363 1.118l1.287 3.957c.3.921-.755 1.688-1.54 1.118l-3.367-2.447a1 1 0 00-1.176 0l-3.367 2.447c-.784.57-1.838-.197-1.539-1.118l1.286-3.957a1 1 0 00-.362-1.118L2.28 9.384c-.783-.57-.38-1.81.588-1.81h4.161a1 1 0 00.951-.69l1.286-3.957z" />
                  </svg>
                ))}
              </div>
              <p class="mt-4 font-sans text-body text-green-900">“{t.data.quote}”</p>
              <div class="mt-6 flex items-center gap-3">
                {t.data.avatar && (
                  <img
                    src={t.data.avatar}
                    alt=""
                    width="44"
                    height="44"
                    loading="lazy"
                    class="h-11 w-11 shrink-0 rounded-full object-cover"
                  />
                )}
                <div>
                  <p class="font-sans text-small font-bold text-green-800">{t.data.author}</p>
                  {t.data.location && (
                    <p class="font-sans text-caption text-green-600">{t.data.location}</p>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="mt-10 max-w-2xl rounded-lg border border-dashed border-line bg-paper p-8">
          <p class="font-sans text-body text-green-700">
            Real customer reviews will appear here.
          </p>
          {/* TODO[CONFIRM]: add 3–5 real Google review quotes as files in
              src/content/testimonials/ (author, location, quote). Never invent quotes. */}
        </div>
      )
    }
  </div>
</section>

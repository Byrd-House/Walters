---
import { site } from "../data/site";
const areas = site.areas.join(" · ");
---

<div class="bg-green-900 text-green-50">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-x-4 px-4 py-2 text-caption lg:px-6"
  >
    <p class="flex items-center gap-1.5">
      <span aria-hidden="true" class="text-accent">★</span>
      <span><strong class="font-bold">{site.rating.value.toFixed(1)}</strong> · {site.rating.count} reviews</span>
    </p>
    <p class="hidden text-green-100 sm:block">{areas}</p>
  </div>
</div>

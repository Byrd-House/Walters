---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MetaPixel from "../components/MetaPixel.astro";
// Vercel Web Analytics. This is the only place it's set up — read the note in
// astro.config.mjs before also enabling the adapter's `webAnalytics` option,
// which is the other half of a duplicate setup that was removed.
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, noindex, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preload the self-hosted faces that paint above the fold: the logo
         wordmark (header, every page) and the display face (hero H1). -->
    <link rel="preload" href="/fonts/brygada-1918-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/TAYBirdieRegular.woff" as="font" type="font/woff" crossorigin />
    <!-- Adobe Fonts kit: Freight ("freight-text-pro") + Avenir ("avenir-lt-pro") -->
    <link rel="stylesheet" href="https://use.typekit.net/ioy6xpq.css" />

    <Seo title={title} description={description} image={image} noindex={noindex} schema={schema} />
    <MetaPixel />
    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

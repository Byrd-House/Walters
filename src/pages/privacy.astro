---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalPage from "../layouts/LegalPage.astro";
import { site } from "../data/site";

// Describes what the site ACTUALLY does. Every claim here is traceable to code:
// collected fields → src/lib/leads/schema.ts, destinations → src/lib/leads/,
// IP handling → src/lib/rate-limit.ts, third-party requests → BaseLayout.astro.
// If any of those change, change this page in the same commit.
const { plausible, metaPixel } = site.tracking;
const anyTracking = plausible || metaPixel;
---

<BaseLayout
  title={`Privacy Policy · ${site.legalName}`}
  description={`How ${site.legalName} handles the information you share through this website.`}
>
  <LegalPage title="Privacy Policy" updated="September 18, 2026">
    <p>
      This policy covers <strong>{site.legalName}</strong> ("we," "us") and this website. It explains
      what we collect, why, and who else sees it. We've kept it specific rather than generic — it
      describes what this site actually does, not what a website might do.
    </p>

    <h2>What we collect</h2>
    <p>
      <strong>Information you give us.</strong> When you submit the quote form, we receive your name,
      phone number, and email address, plus the optional details you choose to add: your address or
      neighborhood, which services you're interested in, your timing, and your message. Nothing on
      this site asks for payment details, and we don't collect them here.
    </p>
    <p>
      <strong>Information collected automatically.</strong> Our host records standard server logs
      (IP address, browser type, pages requested, timestamps) as part of delivering the site. We
      also check your IP address briefly when you submit the form, to limit repeat submissions from
      the same source. That check happens in memory and is discarded within about a minute — it
      isn't written to a database or tied to your submission.
    </p>

    <h2>Cookies and tracking</h2>
    {
      !anyTracking && (
        <p>
          <strong>This site sets no cookies and runs no analytics or advertising trackers.</strong>{" "}
          There is no advertising network, no session tracking, and nothing following you to other
          sites. If that changes, this section changes with it.
        </p>
      )
    }
    {
      plausible && (
        <p>
          <strong>Plausible Analytics.</strong> We use Plausible to see how many people visit and
          which pages they read. Plausible is cookieless and collects no personal information — it
          doesn't build a profile of you, doesn't track you across other websites, and the data we
          see is aggregate only. There is nothing for you to opt out of because there is nothing
          identifying you.
        </p>
      )
    }
    {
      metaPixel && (
        <>
          <p>
            <strong>Meta Pixel.</strong> We use the Meta Pixel (Facebook and Instagram) to measure
            our advertising and to show ads to people who have visited this site. Unlike the rest of
            this site, the pixel <strong>does set cookies</strong>, and it shares information with
            Meta — the pages you view here, the fact that you submitted the quote form, and
            identifiers such as your IP address and cookie ID. Meta uses that information under{" "}
            <a href="https://www.facebook.com/privacy/policy/">its own privacy policy</a>, not ours.
          </p>
          <p>
            <strong>How to turn it off.</strong> You can control this through your{" "}
            <a href="https://www.facebook.com/adpreferences/ad_settings">Meta ad preferences</a>, by
            blocking third-party cookies in your browser, or with a tracker-blocking extension. The
            quote form works normally either way — blocking the pixel will not stop us from
            receiving your request or affect the service you get.
          </p>
        </>
      )
    }

    <h2>How we use it</h2>
    <p>
      We use what you send us to respond to your request, prepare an estimate, schedule and perform
      work, and keep in touch about your project. We'll also use your contact details to follow up
      about work we've discussed or done for you.
    </p>
    <p>
      <strong>We don't sell your information</strong>, and we don't share it with anyone who wants to
      market their own products to you.
    </p>

    <h2>Who else sees it</h2>
    <p>
      We use a small number of service providers to run the site and the business. They only handle
      your information to do work for us:
    </p>
    <ul>
      <li>
        <strong>Vercel</strong> — hosts the website and runs the form's submission endpoint.
      </li>
      <li>
        <strong>Resend</strong> — delivers your quote request to us by email.
      </li>
      <li>
        <strong>Jobber</strong> — our scheduling and customer management software. Quote requests are
        saved there as a customer record so we can follow up and schedule the work.
      </li>
      <li>
        <strong>Adobe Fonts</strong> — serves the typefaces this site uses. Loading a page requests
        the fonts from Adobe, which means Adobe's servers see your IP address.
      </li>
      {plausible && <li><strong>Plausible Analytics</strong> — aggregate visitor statistics.</li>}
      {metaPixel && <li><strong>Meta</strong> — advertising measurement and retargeting, as described above.</li>}
    </ul>
    <p>
      We may also disclose information if the law requires it, or if we need to establish or defend
      a legal claim.
    </p>

    <h2>How long we keep it</h2>
    <p>
      Quote requests stay in our email and in Jobber as part of our customer records. We keep them
      while we're working with you and afterward for our business and tax records. You can ask us to
      delete yours — see below.
    </p>

    <h2>Your choices</h2>
    <p>
      Email or call us and we'll tell you what we have about you, correct it, or delete it. There's no
      form and no process to go through — just ask. If you'd rather not have your information in a
      system at all, call us instead of using the form and we'll take your request by phone.
    </p>

    <h2>Security</h2>
    <p>
      The site is served over HTTPS, and the form's contents are transmitted encrypted. Our providers
      maintain their own security practices. No method of transmission or storage is perfectly
      secure, and we can't promise otherwise.
    </p>

    <h2>Children</h2>
    <p>
      This site is meant for adults arranging work on a property. We don't knowingly collect
      information from children under 13. If you believe a child has sent us information, contact us
      and we'll delete it.
    </p>

    <h2>Changes</h2>
    <p>
      If we change how we handle information, we'll update this page and the date at the top. Material
      changes will be reflected here before they take effect.
    </p>

    <h2>Contact us</h2>
    <p>
      Questions about this policy, or about information we hold:
    </p>
    <ul>
      <li>Phone: <a href={site.phoneHref}>{site.phone}</a></li>
      {site.email && <li>Email: <a href={`mailto:${site.email}`}>{site.email}</a></li>}
      <li>{site.legalName}, {site.areas[0]}, {site.region} {site.zip}</li>
    </ul>
  </LegalPage>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";

const posts = (await getCollection("blog", ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title={`Blog · ${site.legalName}`}
  description="Seasonal tips and plain-spoken advice on lawn care, mulch, and landscaping around Chapel Hill from the Walter's crew."
>
  <section class="mx-auto max-w-7xl px-4 py-16 lg:px-6 lg:py-24">
    <div class="max-w-2xl">
      <h1 class="font-heading text-h2 font-bold text-green-900">From the crew</h1>
      <p class="mt-4 font-sans text-body text-green-800 sm:text-lg/relaxed">
        Seasonal notes and plain advice on keeping a yard sharp around the Triangle.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="mt-12 font-sans text-body text-green-700">
          New posts are on the way. In the meantime,{" "}
          <a href="/contact" class="font-bold underline hover:text-green-900">
            get a quote
          </a>
          .
        </p>
      ) : (
        <ul class="mt-12 divide-y divide-line border-t border-line">
          {posts.map((post) => (
            <li>
              <a href={`/blog/${post.id}`} class="group grid gap-2 py-8 sm:grid-cols-[10rem_1fr] sm:gap-8">
                <time datetime={post.data.pubDate.toISOString()} class="font-sans text-small text-green-600">
                  {fmt(post.data.pubDate)}
                </time>
                <div>
                  <h2 class="font-heading text-h3 font-bold text-green-900 transition-colors group-hover:text-green-700">
                    {post.data.title}
                  </h2>
                  <p class="mt-2 max-w-2xl font-sans text-body text-green-800">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <p class="mt-3 font-sans text-small text-green-600">{post.data.tags.join(" · ")}</p>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
